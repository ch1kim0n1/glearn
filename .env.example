# GLearn Configuration

# LLM API Keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Service Endpoints
GBRAIN_ENDPOINT=http://localhost:3000

# Data Sources
RETENTION_DAYS=90

# Mining Settings
MINING_CADENCE=daily
MIN_DATA_POINTS=100

# Proposal Settings
APPROVAL_THRESHOLD=medium
AUTO_APPLY_BELOW=low
ROLLBACK_ON_REGRESSION=true

# Backtest Settings
BACKTEST_WINDOW_DAYS=30
BACKTEST_MIN_CONFIDENCE=0.7

# Drift Detection
DRIFT_DETECTION_THRESHOLD=0.2
DRIFT_MIN_DATA_POINTS=50

# Logging
LOG_LEVEL=info
